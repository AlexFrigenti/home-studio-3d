{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-development-stack.local/schemas/project-capability-definitions.schema.json",
  "title": "AI Development Stack Project Capability Definitions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItemProperties": ["id"],
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "surface": {
      "enum": ["claude-code", "codex-cli", "codex-app", "gemini-cli", "antigravity-ide", "antigravity-desktop"]
    },
    "boundedScalar": {
      "anyOf": [
        { "type": "string", "maxLength": 256 },
        { "type": "boolean" },
        { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        { "type": "null" }
      ]
    },
    "config": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/boundedScalar" }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surfaces", "checks"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1, "maxLength": 256 },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/surface" }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItemProperties": ["id"],
          "items": { "$ref": "#/$defs/check" }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "primitive", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "primitive": { "$ref": "#/$defs/identifier" },
        "target": { "$ref": "#/$defs/identifier" },
        "config": { "$ref": "#/$defs/config" }
      }
    }
  }
}
