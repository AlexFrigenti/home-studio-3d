{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-development-stack.local/schemas/capability-requirement.schema.json",
  "title": "AI Development Stack Capability Requirement",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "level", "activation"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "level": { "enum": ["REQUIRED", "RECOMMENDED", "OPTIONAL"] },
    "activation": {
      "oneOf": [
        { "const": "always" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tasks"],
          "properties": {
            "tasks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
            }
          }
        }
      ]
    },
    "config": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "anyOf": [
          { "type": "string", "maxLength": 256 },
          { "type": "boolean" },
          { "type": "integer" },
          { "type": "null" }
        ]
      }
    }
  }
}
