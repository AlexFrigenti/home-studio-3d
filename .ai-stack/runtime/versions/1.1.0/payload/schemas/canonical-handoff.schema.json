{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-development-stack.local/schemas/canonical-handoff.schema.json",
  "title": "AI Development Stack Canonical Handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "surface",
    "stackSnapshot",
    "psc",
    "preflight",
    "projectSkill",
    "requiredContext",
    "result"
  ],
  "$defs": {
    "surface": {
      "enum": [
        "claude-code",
        "codex-cli",
        "codex-app",
        "gemini-cli",
        "antigravity-ide",
        "antigravity-desktop"
      ]
    },
    "stackVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "projectRelativePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*:)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$"
    },
    "reference": {
      "oneOf": [
        { "$ref": "#/$defs/projectRelativePath" },
        { "const": "contract:preflight" }
      ]
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "guarantee"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "category": {
          "enum": [
            "native-integration",
            "context-state",
            "capability",
            "integrity-security"
          ]
        },
        "guarantee": {
          "enum": [
            "bootstrap",
            "snapshot",
            "psc",
            "preflight",
            "project-skill",
            "context",
            "handoff",
            "authorization",
            "session"
          ]
        },
        "safeDetails": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 8,
          "properties": {
            "reference": { "$ref": "#/$defs/reference" },
            "expected": { "type": "string", "maxLength": 128 },
            "actual": { "type": "string", "maxLength": 128 },
            "status": { "type": "string", "maxLength": 64 },
            "surface": { "$ref": "#/$defs/surface" }
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest"],
      "properties": {
        "reference": { "$ref": "#/$defs/reference" },
        "digest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "minimumContextItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "digest", "reasonCode"],
      "properties": {
        "kind": { "enum": ["psc", "project-skill", "preflight", "document"] },
        "reference": { "$ref": "#/$defs/reference" },
        "digest": { "$ref": "#/$defs/sha256Digest" },
        "reasonCode": { "$ref": "#/$defs/reasonCode" }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "surface": { "$ref": "#/$defs/surface" },
    "stackSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stackVersion", "activeChecksumsReference", "activeChecksumsDigest"],
      "properties": {
        "stackVersion": { "$ref": "#/$defs/stackVersion" },
        "activeChecksumsReference": { "$ref": "#/$defs/projectRelativePath" },
        "activeChecksumsDigest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "psc": { "$ref": "#/$defs/binding" },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest"],
      "properties": {
        "reference": { "const": "contract:preflight" },
        "digest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "projectSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest"],
      "properties": {
        "reference": { "$ref": "#/$defs/projectRelativePath" },
        "digest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "requiredContext": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/minimumContextItem" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "const": "psc" } }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "const": "project-skill" } }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "const": "preflight" } }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasons"],
      "properties": {
        "status": { "enum": ["materialized", "blocked"] },
        "reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/reason" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "blocked" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "reasons": { "type": "array", "minItems": 1 } }
          }
        }
      ]
    }
  }
}
