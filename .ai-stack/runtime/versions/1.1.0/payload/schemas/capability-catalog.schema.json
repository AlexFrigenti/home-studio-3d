{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-development-stack.local/schemas/capability-catalog.schema.json",
  "title": "AI Development Stack Capability Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "capabilities": {
      "type": "array",
      "uniqueItemProperties": ["id"],
      "items": { "$ref": "#/$defs/capability" }
    },
    "reservedCapabilityIds": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "primitives": {
      "type": "array",
      "maxItems": 64,
      "uniqueItemProperties": ["id"],
      "items": { "$ref": "#/$defs/primitive" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "surface": { "enum": ["claude-code", "codex-cli", "codex-app", "gemini-cli", "antigravity-ide", "antigravity-desktop"] },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surfaces", "checks", "degradedPolicy", "repairs"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/surface" } },
        "checks": { "type": "array", "minItems": 1, "uniqueItemProperties": ["id"], "items": { "$ref": "#/$defs/check" } },
        "degradedPolicy": { "enum": ["allow-with-warning", "block"] },
        "repairs": { "type": "array", "uniqueItemProperties": ["id"], "items": { "$ref": "#/$defs/repair" } }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "targetId", "importance", "driver", "effect", "preflightAllowed", "timeoutMs", "freshness", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "targetId": { "$ref": "#/$defs/identifier" },
        "importance": { "enum": ["essential", "auxiliary"] },
        "driver": { "enum": ["executable", "version", "file-config", "mcp", "authentication", "network"] },
        "effect": { "enum": ["local-read", "local-exec", "network-read"] },
        "preflightAllowed": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 },
        "freshness": { "$ref": "#/$defs/freshness" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAgeSeconds", "fingerprintInputs"],
      "properties": {
        "maxAgeSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "fingerprintInputs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "maxProperties"],
      "properties": {
        "fields": { "type": "array", "uniqueItemProperties": ["name"], "items": { "$ref": "#/$defs/evidenceField" } },
        "maxProperties": { "type": "integer", "minimum": 0, "maximum": 32 }
      }
    },
    "evidenceField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "type": { "enum": ["string", "boolean", "version", "fingerprint", "enum"] },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 256 },
        "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "maxLength": 256 } }
      }
    },
    "configSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "maxProperties"],
      "properties": {
        "fields": {
          "type": "array",
          "maxItems": 8,
          "uniqueItemProperties": ["name"],
          "items": { "$ref": "#/$defs/configField" }
        },
        "maxProperties": { "type": "integer", "minimum": 0, "maximum": 8 }
      }
    },
    "configField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "type": { "enum": ["string", "boolean", "integer", "null"] },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 256 },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 256 }
        }
      }
    },
    "primitive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "driver", "targetClass", "effect", "preflightAllowed", "timeoutMs", "importance", "freshness", "evidence", "configSchema", "degradedPolicyContribution"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "driver": { "enum": ["executable", "version", "file-config", "mcp", "authentication", "network"] },
        "targetClass": { "$ref": "#/$defs/identifier" },
        "effect": { "enum": ["local-read", "local-exec", "network-read"] },
        "preflightAllowed": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 },
        "importance": { "enum": ["essential", "auxiliary"] },
        "freshness": { "$ref": "#/$defs/freshness" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "configSchema": { "$ref": "#/$defs/configSchema" },
        "degradedPolicyContribution": { "enum": ["allow-with-warning", "block"] }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "field", "value"],
      "properties": {
        "type": { "enum": ["state-equals", "evidence-equals"] },
        "field": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$" },
        "value": {
          "anyOf": [
            { "type": "string", "maxLength": 256 },
            { "type": "boolean" },
            { "type": "number", "maximum": 2147483647, "minimum": -2147483648 },
            { "type": "null" }
          ]
        }
      }
    },
    "operationArguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            { "type": "string", "maxLength": 256 },
            { "type": "boolean" },
            { "type": "number", "maximum": 2147483647, "minimum": -2147483648 },
            { "type": "null" }
          ]
        },
        "args": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 256 } }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targetId", "arguments"],
      "properties": {
        "type": { "enum": ["write-allowlisted-config", "delete-allowlisted-config", "run-allowlisted-executable"] },
        "targetId": { "$ref": "#/$defs/identifier" },
        "arguments": { "$ref": "#/$defs/operationArguments" }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "reversible", "reasonCode"],
      "properties": {
        "scope": { "enum": ["local-config", "local-authentication", "local-file"] },
        "reversible": { "type": "boolean" },
        "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability", "surfaces", "applicableWhen", "description", "operations", "impact", "verificationChecks", "rollback"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "capability": { "$ref": "#/$defs/identifier" },
        "surfaces": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/surface" } },
        "applicableWhen": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "description": { "type": "string", "minLength": 1, "maxLength": 512 },
        "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } },
        "impact": { "$ref": "#/$defs/impact" },
        "verificationChecks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported", "policy"],
          "properties": {
            "supported": { "type": "boolean" },
            "policy": { "enum": ["restore-on-failure", "report-only"] }
          }
        }
      }
    }
  }
}
