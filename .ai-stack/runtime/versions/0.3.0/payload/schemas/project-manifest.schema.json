{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-development-stack.local/schemas/project-manifest.schema.json",
  "title": "AI Development Stack Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stackVersion", "projectSkill", "updatePolicy", "capabilities", "context"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "stackVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "projectSkill": { "type": "string", "pattern": "^\\.agents/skills/(?!\\.{1,2}/)[A-Za-z0-9._-]+/SKILL\\.md$" },
    "updatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patch", "minor", "major"],
      "properties": {
        "patch": { "const": "auto-if-valid" },
        "minor": { "const": "require-authorization" },
        "major": { "const": "explicit-migration" }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "https://ai-development-stack.local/schemas/capability-requirement.schema.json"
      }
    },
    "capabilityDefinitions": { "const": ".ai-stack/capabilities.json" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents"],
      "properties": {
        "documents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*:)(?!.*\\\\)(?!.*\\u0000)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$"
          }
        }
      }
    }
  }
}
