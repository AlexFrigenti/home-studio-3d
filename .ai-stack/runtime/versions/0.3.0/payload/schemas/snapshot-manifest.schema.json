{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-development-stack.local/schemas/snapshot-manifest.schema.json",
  "title": "AI Development Stack Snapshot Manifest",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "stackVersion", "contentRoot", "checksumsFile"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "stackVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "contentRoot": { "const": "payload" },
        "checksumsFile": { "const": "checksums.json" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "stackVersion", "contentRoot", "checksumsFile", "runtimeDependencyClosure"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "stackVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "contentRoot": { "const": "payload" },
        "checksumsFile": { "const": "checksums.json" },
        "runtimeDependencyClosure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["roots", "packages"],
          "properties": {
            "roots": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "pattern": "^(?![./])(?!.*\\\\)(?!.*\\.\\.)[^\\u0000]+$" }
            },
            "packages": {
              "type": "array",
              "minItems": 1,
              "uniqueItemProperties": ["name", "payloadPath"],
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "version", "integrity", "payloadPath"],
                "properties": {
                  "name": { "type": "string", "pattern": "^(?:@[a-z0-9._-]+/[a-z0-9._-]+|[a-z0-9._-]+)$" },
                  "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
                  "integrity": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$" },
                  "payloadPath": { "type": "string", "pattern": "^node_modules/(?:@[a-z0-9._-]+/[a-z0-9._-]+|[a-z0-9._-]+)$" }
                }
              }
            }
          }
        }
      }
    }
  ]
}
